<?xml version="1.0" encoding="utf-8"?>
<!--
  Un android:backgroundTint uni s'applique quel que soit l'état : le bouton de
  clôture désactivé garderait sa couleur d'alerte et paraîtrait actionnable. Cette
  liste d'états lui donne un vrai rendu grisé tant que le comptage est incomplet.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:color="#BDBDBD"
        android:state_enabled="false" />

    <item android:color="@color/warning" />

</selector>
