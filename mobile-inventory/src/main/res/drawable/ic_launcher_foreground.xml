<?xml version="1.0" encoding="utf-8"?>
<!--
  Avant-plan de l'icône adaptative : carton + coche en blanc sur le fond de marque.

  Tracé et non aplats, pour que la coche reste lisible et que la variante `monochrome`
  (thèmes dynamiques Android 13+) fonctionne.

  Le symbole de 24dp est mis à l'échelle 2.4× (57,6dp) et centré dans le canevas de
  108dp : il reste dans la zone de sécurité de 72dp, marge de 25dp de chaque côté.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="25.2"
        android:translateY="25.2">

        <!-- Couvercle -->
        <path
            android:fillColor="#00000000"
            android:pathData="M2.5,3.5 L21.5,3.5 L21.5,7.5 L2.5,7.5 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8"
            android:strokeLineJoin="round" />

        <!-- Corps du carton -->
        <path
            android:fillColor="#00000000"
            android:pathData="M4,7.5 L4,19.5 L20,19.5 L20,7.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8"
            android:strokeLineJoin="round" />

        <!-- Coche : produit compté -->
        <path
            android:fillColor="#00000000"
            android:pathData="M8.5,13.2 L11,15.7 L15.5,11.2"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
