<?xml version="1.0" encoding="utf-8"?>
<!--
  Thème aligné sur le module de vente (sales-android/res/values/themes.xml).
  Toute évolution doit être répercutée dans les deux modules.
-->
<resources>
    <!-- Base Theme -->
    <style name="Base.Theme.PharmaSmartInventory" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Brand Color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary Brand Color -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Error Color -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Background Color -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Surface Color -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!--
          Barre d'état. À partir d'Android 15 (targetSdk 35+), le mode bord-à-bord est
          imposé et `android:statusBarColor` est ignoré : la barre est transparente et
          laisse voir le fond de l'écran, clair dans cette application. Les icônes
          doivent donc être sombres — d'où `windowLightStatusBar = true`, à l'inverse du
          module de vente qui cible un SDK plus ancien.
        -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Boîtes de dialogue à la charte -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PharmaSmart.MaterialAlertDialog</item>
    </style>

    <!-- Main Application Theme -->
    <style name="Theme.PharmaSmartInventory" parent="Base.Theme.PharmaSmartInventory" />

    <!-- Splash Screen Theme — logo propre à l'inventaire, pas celui de la vente -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PharmaSmartInventory</item>
    </style>

    <!-- Material Alert Dialog — Pharma branded -->
    <style name="ThemeOverlay.PharmaSmart.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/white</item>
        <item name="materialAlertDialogTitleTextStyle">@style/PharmaSmart.MaterialAlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/PharmaSmart.MaterialAlertDialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/PharmaSmart.MaterialAlertDialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/PharmaSmart.MaterialAlertDialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/PharmaSmart.MaterialAlertDialog.Button.Neutral</item>
        <item name="shapeAppearanceOverlay">@style/PharmaSmart.MaterialAlertDialog.Shape</item>
    </style>

    <style name="PharmaSmart.MaterialAlertDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PharmaSmart.MaterialAlertDialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PharmaSmart.MaterialAlertDialog.Button.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="PharmaSmart.MaterialAlertDialog.Button.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/gray_500</item>
    </style>

    <style name="PharmaSmart.MaterialAlertDialog.Button.Neutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/gray_500</item>
    </style>

    <style name="PharmaSmart.MaterialAlertDialog.Shape" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Toggle Button Group — Pharma branded -->
    <style name="Widget.PharmaSmart.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_button_bg</item>
        <item name="android:textColor">@color/toggle_button_text</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
