<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo du module Inventaire — carton avec coche de comptage.

  Dessiné en **tracé** (contours) et non en aplats : l'icône est utilisée teintée d'une
  seule couleur (`app:tint` sur l'écran de connexion, `monochrome` pour l'icône
  adaptative). Avec des formes pleines superposées, la coche disparaîtrait dans le
  carton.

  Volontairement distinct de `ic_pharma_logo` (presse-papiers) du module de vente : les
  deux applications cohabitent sur les mêmes terminaux.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#5B89A6">

    <!-- Couvercle -->
    <path
        android:fillColor="#00000000"
        android:pathData="M2.5,3.5 L21.5,3.5 L21.5,7.5 L2.5,7.5 Z"
        android:strokeColor="#5B89A6"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round" />

    <!-- Corps du carton -->
    <path
        android:fillColor="#00000000"
        android:pathData="M4,7.5 L4,19.5 L20,19.5 L20,7.5"
        android:strokeColor="#5B89A6"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round" />

    <!-- Coche : produit compté -->
    <path
        android:fillColor="#00000000"
        android:pathData="M8.5,13.2 L11,15.7 L15.5,11.2"
        android:strokeColor="#5B89A6"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
