{
  "name": "pharmasmart",
  "version": "0.0.2",
  "private": true,
  "description": "Description for pharma-smart",
  "license": "UNLICENSED",
  "sideEffects": false,
  "scripts": {
    "build": "npm run webapp:prod --",
    "build:i18n": "node scripts/build-i18n.js",
    "clean-www": "rimraf pharmaSmart-app/target/classes/static/",
    "cleanup": "rimraf target/ pharmaSmart-app/target/",
    "generate:cahier-recette": "tsx scripts/generate-cahier-recette-json.ts",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prettier:check": "prettier --check \"{,src/**/,webpack/,.blueprint/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,css,scss}\"",
    "prettier:format": "prettier --write \"{,src/**/,webpack/,.blueprint/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,css,scss}\"",
    "serve": "npm run start --",
    "prestart": "npm run build:i18n",
    "start": "node scripts/build-app.js serve development",
    "start-tls": "npm run webapp:dev-ssl",
    "tauri": "tauri",
    "version:sync": "node scripts/sync-version.js",
    "tauri:copy-winsw": "node scripts/copy-winsw.js",
    "tauri:build": "npm run version:sync && npm run webapp:build:tauri && npm run tauri:copy-winsw && tauri build",
    "tauri:build:bundled": "npm run version:sync && npm run webapp:build:tauri && npm run tauri:prepare-sidecar && tauri build --config src-tauri/tauri.bundled.conf.json --features bundled-backend",
    "tauri:build:bundled-jre": "npm run version:sync && npm run webapp:build:tauri && npm run tauri:prepare-sidecar && tauri build --config src-tauri/tauri.bundled-jre.conf.json --features bundled-backend",
    "tauri:build:bundled-jre:debug": "npm run version:sync && npm run webapp:build:tauri && npm run tauri:prepare-sidecar && tauri build --debug --config src-tauri/tauri.bundled-jre.conf.json --features bundled-backend",
    "tauri:build:bundled-jre:fast": "npm run version:sync && npm run tauri:prepare-sidecar && tauri build --config src-tauri/tauri.bundled-jre.conf.json --features bundled-backend",
    "tauri:build:bundled:debug": "npm run version:sync && npm run webapp:build:tauri && npm run tauri:prepare-sidecar && tauri build --debug --config src-tauri/tauri.bundled.conf.json --features bundled-backend",
    "tauri:build:bundled:fast": "npm run version:sync && npm run tauri:prepare-sidecar && tauri build --config src-tauri/tauri.bundled.conf.json --features bundled-backend",
    "tauri:build:debug": "npm run version:sync && npm run webapp:build:tauri && npm run tauri:copy-winsw && tauri build --debug",
    "tauri:build:fast": "npm run version:sync && npm run tauri:copy-winsw && tauri build",
    "tauri:dev": "tauri dev",
    "tauri:prepare-sidecar": "node scripts/prepare-sidecar.js",
    "tauri:prepare-backup": "node scripts/prepare-backup.js",
    "pretest": "npm run lint",
    "test": "ng test --coverage --log-heap-usage -w=2",
    "test:watch": "npm run test -- --watch",
    "webapp:build": "npm run clean-www && npm run webapp:build:dev",
    "prewebapp:build:dev": "npm run build:i18n",
    "webapp:build:dev": "node scripts/build-app.js build development",
    "prewebapp:build:prod": "npm run build:i18n",
    "webapp:build:prod": "node scripts/build-app.js build production",
    "prewebapp:build:tauri": "npm run build:i18n",
    "webapp:build:tauri": "npm run clean-www && node scripts/build-app.js build tauri",
    "prewebapp:dev": "npm run build:i18n",
    "webapp:dev": "node scripts/build-app.js serve development",
    "prewebapp:dev-ssl": "npm run build:i18n",
    "webapp:dev-ssl": "node scripts/build-app.js serve development --ssl",
    "prewebapp:dev-verbose": "npm run build:i18n",
    "webapp:dev-verbose": "node scripts/build-app.js serve development --verbose",
    "webapp:prod": "npm run clean-www && npm run webapp:build:prod",
    "webapp:test": "npm run test --"
  },
  "config": {
    "backend_port": "9080",
    "default_environment": "prod",
    "packaging": "jar"
  },
  "dependencies": {
    "@ag-grid-community/locale": "^36.1.0",
    "@angular/animations": "^22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/localize": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/service-worker": "^22.1.1",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ng-select/ng-select": "^24.0.0",
    "@ngrx/signals": "^21.1.1",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@popperjs/core": "2.11.8",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "ag-grid-angular": "^36.1.0",
    "ag-grid-community": "^36.1.0",
    "bootstrap": "~5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootswatch": "5.3.8",
    "buffer": "6.0.3",
    "chart.js": "4.5.1",
    "dayjs": "1.11.21",
    "file-saver": "^2.0.5",
    "gridstack": "^13.0.0",
    "ngx-spinner": "^21.1.0",
    "ngx-webstorage": "21.0.1",
    "primeicons": "^8.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-builders/jest": "22.0.1",
    "@angular-devkit/build-angular": "^22.1.1",
    "@angular/cli": "^22.1.1",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "30.0.0",
    "@types/node": "^25.6.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "folder-hash": "4.1.3",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jest": "^30.3.0",
    "jest-date-mock": "^1.0.10",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^17.0.0",
    "jest-preset-angular": "^17.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "overrides": {
    "@ngrx/signals": {
      "@angular/core": "$@angular/core"
    },
    "ngx-webstorage": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common"
    }
  }
}
